data/seq/*.jsonl.gz

# Models / checkpoints
ckpt/
*.pt
*.pth
*.safetensors
*.bin
*.pkl

# OS / editor
.DS_Store

# Course handouts (not part of the repo)
project-guidelines.pdf
project-titles.pdf

